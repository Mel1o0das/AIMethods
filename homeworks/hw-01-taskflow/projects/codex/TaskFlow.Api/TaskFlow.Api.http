@TaskFlow.Api_HostAddress = http://localhost:5005
@taskId = 00000000-0000-0000-0000-000000000000

GET {{TaskFlow.Api_HostAddress}}/api/tasks
Accept: application/json

###

POST {{TaskFlow.Api_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Prepare demo",
  "description": "Check TaskFlow API"
}

###

GET {{TaskFlow.Api_HostAddress}}/api/tasks/{{taskId}}
Accept: application/json

###

PATCH {{TaskFlow.Api_HostAddress}}/api/tasks/{{taskId}}/status
Content-Type: application/json

{
  "status": "Completed"
}
