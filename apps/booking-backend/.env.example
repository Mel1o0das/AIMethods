# Copy to .env and replace every change-me value. Do not commit .env.
POSTGRES_DB=booking_service
POSTGRES_USER=booking_app
POSTGRES_PASSWORD=change-me-use-a-random-database-password
JWT_SECRET_KEY=change-me-use-a-random-key-with-at-least-32-characters
JWT_ISSUER=BookingService
JWT_AUDIENCE=BookingService
API_PORT=5260
FRONTEND_ORIGIN=http://localhost:3000
IMAGES_PUBLIC_URL=http://localhost:5260/images
ASPNETCORE_ENVIRONMENT=Development
SEED_DATA_ENABLED=true
